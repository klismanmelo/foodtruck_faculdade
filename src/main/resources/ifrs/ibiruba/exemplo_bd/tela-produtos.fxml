<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ifrs.ibiruba.exemplo_bd.controller.TelaProdutosController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <left>
        <VBox prefWidth="390.0" spacing="11.0" styleClass="cartao-formulario">
            <BorderPane.margin>
                <Insets right="22.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="22.0" right="22.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="titulo-secao" text="Cadastro de produto" />
                <Label text="Nome" />
                <TextField fx:id="tfNomeProduto" promptText="Ex.: X-Búrguer" />
                <Label text="Descrição" />
                <TextArea fx:id="taDescricaoProduto" prefRowCount="2" promptText="Ingredientes ou observações" wrapText="true" />
                <GridPane hgap="12.0" vgap="6.0">
                    <children>
                        <Label text="Preço" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Label text="Categoria" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <TextField fx:id="tfPrecoProduto" promptText="0,00" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <ComboBox fx:id="cbCategoriaProduto" maxWidth="1.7976931348623157E308" promptText="Selecione" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="36.0" />
                        <ColumnConstraints percentWidth="64.0" />
                    </columnConstraints>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
                <Label text="Complementos permitidos" />
                <ListView fx:id="lvComplementosProduto" prefHeight="120.0" />
                <Label styleClass="dica" text="Use Ctrl (Windows/Linux) ou ⌘ (macOS) para selecionar vários." wrapText="true" />
                <HBox spacing="9.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#salvarProduto" styleClass="botao-primario" text="Salvar" HBox.hgrow="ALWAYS" />
                        <Button onAction="#limparFormulario" text="Limpar" />
                        <Button onAction="#excluirProduto" styleClass="botao-perigo" text="Excluir" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" styleClass="cartao-tabela">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <VBox HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="titulo-secao" text="Produtos cadastrados" />
                                <Label styleClass="texto-apoio" text="Selecione uma linha para editar ou excluir." />
                            </children>
                        </VBox>
                        <TextField fx:id="tfPesquisaProduto" prefWidth="240.0" promptText="Pesquisar por nome..." />
                    </children>
                </HBox>
                <TableView fx:id="tvProdutos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProdutoId" prefWidth="55.0" text="ID" />
                        <TableColumn fx:id="colProdutoNome" prefWidth="145.0" text="Nome" />
                        <TableColumn fx:id="colProdutoDescricao" prefWidth="230.0" text="Descrição" />
                        <TableColumn fx:id="colProdutoPreco" prefWidth="100.0" text="Preço" />
                        <TableColumn fx:id="colProdutoCategoria" prefWidth="130.0" text="Categoria" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Label fx:id="lbTotalProdutos" styleClass="contador" text="0 produto(s)" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
