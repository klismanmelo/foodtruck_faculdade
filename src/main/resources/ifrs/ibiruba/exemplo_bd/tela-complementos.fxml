<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ifrs.ibiruba.exemplo_bd.controller.TelaComplementosController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <left>
        <VBox prefWidth="350.0" spacing="12.0" styleClass="cartao-formulario">
            <BorderPane.margin>
                <Insets right="22.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
            </padding>
            <children>
                <Label styleClass="titulo-secao" text="Cadastro de complemento" />
                <Label styleClass="texto-apoio" text="Cadastre opções que podem acompanhar os produtos." wrapText="true" />
                <Label text="Nome" />
                <TextField fx:id="tfNomeComplemento" promptText="Ex.: Bacon extra" />
                <Label text="Preço adicional" />
                <TextField fx:id="tfPrecoComplemento" onAction="#salvarComplemento" promptText="0,00" />
                <HBox spacing="9.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#salvarComplemento" styleClass="botao-primario" text="Salvar" HBox.hgrow="ALWAYS" />
                        <Button onAction="#limparFormulario" text="Limpar" />
                        <Button onAction="#excluirComplemento" styleClass="botao-perigo" text="Excluir" />
                    </children>
                </HBox>
                <Label styleClass="dica" text="Ao selecionar uma linha, os dados são carregados no formulário para edição." wrapText="true" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" styleClass="cartao-tabela">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="titulo-secao" text="Complementos cadastrados" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lbTotalComplementos" styleClass="contador" text="0 complemento(s)" />
                    </children>
                </HBox>
                <TableView fx:id="tvComplementos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colComplementoId" prefWidth="70.0" text="ID" />
                        <TableColumn fx:id="colComplementoNome" prefWidth="360.0" text="Nome" />
                        <TableColumn fx:id="colComplementoPreco" prefWidth="170.0" text="Preço adicional" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
