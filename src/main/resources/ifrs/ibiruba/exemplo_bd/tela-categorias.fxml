<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ifrs.ibiruba.exemplo_bd.controller.TelaCategoriasController">
    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="24.0" />
    </padding>
    <left>
        <VBox prefWidth="330.0" spacing="12.0" styleClass="cartao-formulario">
            <BorderPane.margin>
                <Insets right="22.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
            </padding>
            <children>
                <Label styleClass="titulo-secao" text="Nova categoria" />
                <Label styleClass="texto-apoio" text="Ex.: Lanches, Bebidas ou Sobremesas" wrapText="true" />
                <Label text="Nome" />
                <TextField fx:id="tfNomeCategoria" onAction="#salvarCategoria" promptText="Nome da categoria" />
                <HBox spacing="10.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" onAction="#salvarCategoria" styleClass="botao-primario" text="Adicionar" HBox.hgrow="ALWAYS" />
                        <Button onAction="#excluirCategoria" styleClass="botao-perigo" text="Excluir selecionada" />
                    </children>
                </HBox>
                <Label styleClass="dica" text="Dica: dê dois cliques no nome da tabela para editá-lo." wrapText="true" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" styleClass="cartao-tabela">
            <padding>
                <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="titulo-secao" text="Categorias cadastradas" HBox.hgrow="ALWAYS" />
                        <Label fx:id="lbTotalCategorias" styleClass="contador" text="0 categoria(s)" />
                    </children>
                </HBox>
                <TableView fx:id="tvCategorias" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCategoriaId" editable="false" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colCategoriaNome" prefWidth="500.0" text="Nome" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>
